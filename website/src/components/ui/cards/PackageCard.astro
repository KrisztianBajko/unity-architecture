---
import Card from "./Card.astro";
import Badge from "../Badge.astro";

interface Props
{
    title: string;
    description: string;
    status: "Available" | "In Development" | "Planned";
    href: string;
}

const
{
    title,
    description,
    status,
    href
} = Astro.props;

const badgeVariant =
    status === "Available"
        ? "success"
        : status === "In Development"
            ? "warning"
            : "neutral";
---

<Card class="package-card" href={href}>
    <h3 class="package-card__title">
        {title}
    </h3>

    <p class="package-card__description">
        {description}
    </p>

    <div class="package-card__status">
    <Badge
    label={status}
    variant={badgeVariant}
    />
    </div>

</Card>