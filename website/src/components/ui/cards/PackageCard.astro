---
import Card from "./Card.astro";
import Badge from "../Badge.astro";
import Stack from "../../layout/Stack.astro";
import { statusBadgeVariant } from "../../../data/packageStatus";
import type { PackageStatus } from "../../../data/packageStatus";

interface Props
{
    title: string;
    description: string;
    status: PackageStatus;
    href: string;
}

const
{
    title,
    description,
    status,
    href
} = Astro.props;

const badgeVariant = statusBadgeVariant[status];
---

<Card href={href} class="package-card">
    <Stack gap="sm">
        <h3 class="package-card__title">{title}</h3>

        <p class="package-card__description">
            {description}
        </p>
    </Stack>

    <div class="package-card__status">
        <Badge
            label={status}
            variant={badgeVariant}
        />
    </div>
</Card>