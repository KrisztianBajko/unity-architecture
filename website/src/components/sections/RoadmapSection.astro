---
import SectionHeader from "../ui/SectionHeader.astro";
import Badge from "../ui/Badge.astro";
import { packageItems } from "../../data/packages";
import { statusBadgeVariant } from "../../data/packageStatus";
import type { PackageStatus } from "../../data/packageStatus";

const statuses: PackageStatus[] = ["Available", "In Development", "Planned"];

const columns = statuses.map((status) => ({
    status,
    variant: statusBadgeVariant[status],
    items: packageItems.filter((p) => p.status === status),
}));
---

<section class="section roadmap-section">
    <div class="section__inner">
        <SectionHeader
            title="Roadmap"
            description="Unity Architecture is being built in the open. Here is what is available, what is in progress, and what is coming next."
        />

        <div class="roadmap-grid">
            {
                columns.map((column) => (
                    <div class="roadmap-column">
                        <div class="roadmap-column__header">
                            <Badge
                                label={column.status}
                                variant={column.variant}
                            />
                        </div>

                        <ul class="roadmap-column__list">
                            {
                                column.items.map((item) => (
                                    <li class="roadmap-column__item">
                                        {item.title}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="roadmap-footer">
            <a href="/roadmap" class="roadmap-link">
                View full roadmap →
            </a>
        </div>
    </div>
</section>