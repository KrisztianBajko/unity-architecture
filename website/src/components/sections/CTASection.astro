---
import Button from "../ui/Button.astro";
---

<section class="section cta-section">
    <div class="section__inner">
        <div class="cta">
            <h2 class="cta__title">
                Start Building Better Unity Projects
            </h2>

            <p class="cta__description">
                Read the handbook, explore the toolkit, and apply professional
                architecture patterns to your next Unity project.
            </p>

            <div class="cta__actions">
                <Button
                    label="Start Learning"
                    href="/learn"
                    variant="primary"
                />

                <Button
                    label="Explore Toolkit"
                    href="/toolkit"
                    variant="secondary"
                />
            </div>
        </div>
    </div>
</section>